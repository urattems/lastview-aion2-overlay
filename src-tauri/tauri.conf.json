{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LastView",
  "version": "0.1.0",
  "identifier": "io.github.urattems.lastview",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420/bulle.html",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "bulle",
        "title": "LastView",
        "url": "bulle.html",
        "width": 320,
        "height": 260,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "shadow": false,
        "visible": false,
        "focus": false
      },
      {
        "label": "fiche",
        "title": "LastView — fiche joueur",
        "url": "fiche.html",
        "width": 1100,
        "height": 760,
        "minWidth": 720,
        "minHeight": 480,
        "visible": false,
        "center": true
      },
      {
        "label": "parametres",
        "title": "LastView — paramètres",
        "url": "parametres.html",
        "width": 720,
        "height": 820,
        "minWidth": 560,
        "minHeight": 480,
        "visible": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: http://lvimg.localhost lvimg:; style-src 'self' 'unsafe-inline'; font-src 'self'; connect-src 'self' ipc: http://ipc.localhost http://lvimg.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "urattems",
    "category": "Utility",
    "shortDescription": "LastView — Aion 2 Overlay",
    "copyright": "GPL-3.0",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"]
  }
}
